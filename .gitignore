# ignore directories
/.backups/*
!/.backups/.gitkeep

/core/*
!/core/wp-content/
/core/wp-content/*
!/core/**/.gitkeep

**/node_modules

/workspace/*
!/workspace/plugins/
!/workspace/themes/
/workspace/plugins/*
!/workspace/plugins/.gitkeep
/workspace/themes/*
!/workspace/themes/.gitkeep

# configuration files
.env*
!.env.example
